# Shoppy Backend Environment Configuration Template
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB Connection
MONGODB_URL=mongodb://localhost:27017

# JWT Authentication Secrets
ACCESS_TOKEN_KEY=shoppy_access_token_secret_key_development_example
ACCESS_TOKEN_EXPIRY=15m
ACCESS_REFRESH_KEY=shoppy_refresh_token_secret_key_development_example
ACCESS_REFRESH_EXPIRY=7d
